GRAPHITI_SERVICE_URL=http://localhost:8000
GRAPHITI_SERVICE_API_KEY=<optional-api-key>
# Viewer 側で FastAPI が落ちている際にローカルモックを使う場合のみ true
GRAPHITI_USE_SAMPLE_DATA=false

# ドライバー選択: neo4j または falkordb (graphiti_service 用)
GRAPHITI_DRIVER=neo4j

# Neo4j 接続情報 (GRAPHITI_DRIVER=neo4j の場合)
GRAPHITI_NEO4J_URI=bolt://localhost:7687
GRAPHITI_NEO4J_USER=neo4j
GRAPHITI_NEO4J_PASSWORD=secret

# FalkorDB 接続情報 (GRAPHITI_DRIVER=falkordb の場合)
# GRAPHITI_FALKORDB_HOST=localhost
# GRAPHITI_FALKORDB_PORT=6379
# GRAPHITI_FALKORDB_USER=
# GRAPHITI_FALKORDB_PASSWORD=
# GRAPHITI_FALKORDB_DATABASE=
